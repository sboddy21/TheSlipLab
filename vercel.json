{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "website",
  "functions": {
    "website/api/member-data.mjs": {
      "includeFiles": "website/data/**/*.json"
    }
  },
  "rewrites": [
    {
      "source": "/data/:file*",
      "destination": "/api/member-data?file=:file*"
    }
  ]
}
