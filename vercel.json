{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "outputDirectory": "website",
  "functions": {
    "website/api/ncaam-ai-analysis.mjs": {
      "includeFiles": "website/data/ncaam_board.json",
      "maxDuration": 45
    },
    "website/api/member-data.mjs": {
      "includeFiles": "website/data/**/*.json",
      "maxDuration": 60
    }
  }
}
