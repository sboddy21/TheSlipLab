{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "website",
  "functions": {
    "website/api/member-data.mjs": {
      "includeFiles": "website/data/**/*.json"
    }
  },
  "routes": [
    {
      "src": "/data/(.*)",
      "dest": "/api/member-data?file=$1"
    },
    {
      "handle": "filesystem"
    }
  ]
}
